{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kpis/catalog.schema.json",
  "title": "KPI catalog",
  "type": "object",
  "required": ["version", "cases", "kpis"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "cases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["title", "tables"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string", "minLength": 3},
          "tables": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "kpis": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/kpi"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 10},
    "kpi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "case", "question", "meaning", "definition", "calculation", "formula", "unit", "granularity",
                   "direction", "target", "thresholds", "owner", "source", "input", "how_to_read",
                   "misreadings", "decision", "balance", "related", "chart"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "name": {"type": "string", "minLength": 3},
        "case": {"type": "string"},
        "question": {"type": "string", "pattern": "¿.*\\?$"},
        "definition": {"$ref": "#/$defs/text"},
        "meaning": {"$ref": "#/$defs/text"},
        "calculation": {"$ref": "#/$defs/text"},
        "decision": {"$ref": "#/$defs/text"},
        "balance": {"$ref": "#/$defs/text"},
        "formula": {"type": "string", "minLength": 5},
        "unit": {"enum": ["percent", "hours", "days", "times_per_year", "score"]},
        "granularity": {"$ref": "#/$defs/text"},
        "direction": {"enum": ["higher_is_better", "lower_is_better", "target_range"]},
        "target": {"type": "number"},
        "thresholds": {
          "type": "object",
          "required": ["green", "amber"],
          "additionalProperties": false,
          "properties": {
            "green": {"$ref": "#/$defs/bound"},
            "amber": {"$ref": "#/$defs/bound"}
          }
        },
        "params": {"type": "object", "additionalProperties": {"type": ["number", "string"]}},
        "owner": {"type": "string", "minLength": 3},
        "source": {"type": "string", "minLength": 3},
        "input": {
          "type": "object",
          "required": ["table", "columns"],
          "additionalProperties": false,
          "properties": {
            "table": {"type": "string"},
            "columns": {"type": "array", "items": {"type": "string"}}
          }
        },
        "how_to_read": {"$ref": "#/$defs/text"},
        "misreadings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "related": {"type": "array", "items": {"type": "string"}},
        "chart": {
          "type": "object",
          "required": ["type", "why"],
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["line", "bar", "bullet", "histogram", "boxplot", "heatmap", "scatter"]},
            "why": {"$ref": "#/$defs/text"}
          }
        },
        "sql": {"type": "string", "minLength": 5}
      }
    },
    "bound": {
      "oneOf": [
        {"type": "number"},
        {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
      ]
    }
  }
}
